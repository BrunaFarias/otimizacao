let ind[5] := ny1*(ny1+1)/2;
let ind[6] := ny2*(ny2+1)/2;
let ind[7] := (nu1+1)*(nu1+2)/2;
let ind[8] := (nu2+1)*(nu2+2)/2;
let ind[9] := ny1*(nu1+1);
let ind[10] := ny1*(nu2+1);
let ind[11] := ny2*(nu1+1);
